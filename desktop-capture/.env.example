# Verdant desktop-capture configuration.
# Copy to `.env` and `source` it, or export these in your shell, or put the
# same keys (without the VERDANT_ prefix) in ~/.verdant/config under [verdant].

# Backend product API base URL.
VERDANT_API_URL=http://localhost:8000

# --- Auth: choose ONE path ---
# 1) Workspace API key (carries its own workspace; simplest).
VERDANT_API_KEY=

# 2) Email + password login (yields a token). Also set a workspace id, or the
#    first workspace on the account is used.
VERDANT_EMAIL=
VERDANT_PASSWORD=
VERDANT_WORKSPACE_ID=

# Optional: override the transcript-ingest path if your backend mounts a
# (non-public) botless ingest endpoint. Supports the {meeting_id} placeholder.
# The public contract does NOT expose one, so this is empty by default and the
# client keeps a local transcript + still drives /summarize.
# VERDANT_INGEST_PATH=/internal/meetings/{meeting_id}/segments
