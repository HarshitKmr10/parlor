# --- AI service configuration ---------------------------------------------
# Copy to .env and fill in. With NO keys set the service boots in mock mode.

# Mode: mock | live. If unset, auto-detected (live when a key is present).
AI_MODE=

# Provider routing mode: fallback | pinned. Default fallback tries every
# configured live provider in AI_PROVIDER_ORDER; pinned tries ONLY
# AI_PINNED_PROVIDER (mock still runs as the final safety net either way).
AI_PROVIDER_MODE=fallback
# Required when AI_PROVIDER_MODE=pinned. One of: azure, anthropic, openai,
# gemini, openai_compatible. Fails fast at startup if not a configured live
# provider.
AI_PINNED_PROVIDER=

# Provider routing order (fallback mode only). First success wins; falls
# through on error.
AI_PROVIDER_ORDER=azure,anthropic,openai

# Azure OpenAI (primary live provider; routes by DEPLOYMENT NAME, not model id).
# Set endpoint + key to go live. NEVER commit real keys — fill in .env only.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Optional cheap-tier deployment; falls back to AZURE_OPENAI_DEPLOYMENT when unset.
AZURE_OPENAI_CHEAP_DEPLOYMENT=
# Optional. If unset, embeddings fall through to the deterministic mock embedder.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Additional fallback provider keys (leave blank to run in mock mode).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini isn't in the default AI_PROVIDER_ORDER above, but participates in
# the fallback chain (and can be added to AI_PROVIDER_ORDER, or set as
# AI_PINNED_PROVIDER) once a key is set here.
GEMINI_API_KEY=
# Optional per-provider/per-tier model overrides (defaults shown are current-gen).
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
OPENAI_MODEL_PREMIUM=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini
GEMINI_MODEL_PREMIUM=gemini-3.1-pro-preview
GEMINI_MODEL_CHEAP=gemini-3.5-flash

# Generic OpenAI-Chat-Completions-API-compatible provider: covers OpenRouter
# and self-hosted deployments (vLLM, Ollama, LM Studio, etc). Set base URL to
# enable; API key is optional for local servers that don't require one.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Postgres connection (must have the pgvector extension available).
# Required for /embed and /chat. /summarize works without it.
# Example for the local pgvector docker container on port 5433:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE_URL=

# Port (defaults to 8100).
AI_SERVICE_PORT=8100
