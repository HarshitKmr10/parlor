# --- AI service configuration ---------------------------------------------
# Copy to .env and fill in. With NO keys set the service boots in mock mode.

# Mode: mock | live. If unset, auto-detected (live when a key is present).
AI_MODE=

# Provider routing order. First success wins; falls through on error.
AI_PROVIDER_ORDER=anthropic,openai

# Provider API keys (leave blank to run in mock mode).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres connection (must have the pgvector extension available).
# Required for /embed and /chat. /summarize works without it.
# Example for the local pgvector docker container on port 5433:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE_URL=

# Port (defaults to 8100).
AI_SERVICE_PORT=8100
