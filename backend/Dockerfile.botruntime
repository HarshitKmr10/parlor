# =============================================================================
# Parlor bot-runtime image (standalone backend/ layout).
# =============================================================================
# One image that serves the FastAPI product API AND can actually spawn the
# real Playwright/Node meeting bot locally (LocalBotRunner subprocess path),
# so the standalone stack no longer degrades to `bot_runtime_unavailable`.
#
# vs backend/Dockerfile.dev (lightweight, API-only):
#   - that image has Python only — no Node, no Chromium, no display/audio, so
#     LocalBotRunner's _runtime_check() returns bot_runtime_unavailable_no_*.
#   - THIS image adds: Node 18 + pnpm + node_modules, Playwright Chromium +
#     its system deps, Xvfb + pulseaudio + ffmpeg, and a local Whisper cache
#     so keyless STT (LLM_PROVIDER=local_whisper) works with no cloud keys.
#
# The entrypoint starts Xvfb (:99) + pulseaudio, then execs uvicorn. The SAME
# container serves the API and spawns bots that open Chromium on DISPLAY=:99.
#
# It is intentionally large/slow to build (browser + browser deps + node_modules
# + python deps). Use Dockerfile.dev for fast API-only iteration.
#
# NOTE on the standalone layout: there is NO monorepo `core/` or
# `meeting-joiner/` path here. The app lives at /app/src/... (not
# /app/meeting-joiner/src/...). The compose override sets
# NODE_BOT_ENTRYPOINT=/app/src/bot/bot_scripts/sidecar_launcher.js so
# LocalBotRunner resolves the bot tree in this layout.
# =============================================================================

# ── Stage: build the humanclick Rust binary ─────────────────────────────────
# Real XTEST pointer/keyboard input for the Google Meet join flow (see
# src/bot/humanclick and src/bot/bot_scripts/googlemeet/humanized.js) — a
# separate build stage so the final image doesn't carry the Rust toolchain,
# only the compiled binary.
FROM rust:1-slim-bookworm AS humanclick-builder
WORKDIR /build
COPY src/bot/humanclick/Cargo.toml src/bot/humanclick/Cargo.lock ./
COPY src/bot/humanclick/src ./src
RUN cargo build --release

# ── Stage: Node 18 runtime, sourced from the official image ─────────────────
# Previously installed via `curl https://deb.nodesource.com/setup_18.x | bash -`
# — a script piped straight into a root shell with no integrity check. Instead,
# take the Node binaries/runtime from the official `node:18` image (itself
# built + published by the Node.js project) and COPY them into the final image
# below. This keeps the exact same Node 18.x line the bot has always run on,
# with no curl-|-bash step anywhere in this Dockerfile.
FROM node:18-bookworm-slim AS node_source

# Debian-based python image (glibc) so Playwright's Chromium + system deps and
# the @xenova/transformers (onnxruntime) prebuilt binaries work out of the box.
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# ── System packages ─────────────────────────────────────────────────────────
# build deps for asyncpg/argon2 wheels (mirrors Dockerfile.dev) PLUS the
# display/audio/media stack the bot needs (mirrors meeting_worker.Dockerfile):
#   - xvfb + xauth + xdpyinfo  → virtual display :99 for headful Chromium
#   - pulseaudio + utils       → virtual audio sink for capture
#   - ffmpeg                   → audio decode for local whisper STT
#   - curl/ca-certs            → healthcheck / misc downloads
# Playwright's own browser OS deps are installed later via
# `playwright install --with-deps chromium`, so we keep this list lean.
# Node itself comes from the node_source stage COPY below, not apt/nodesource.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc g++ libpq-dev postgresql-client \
      curl ca-certificates \
      xvfb xauth x11-utils \
      pulseaudio pulseaudio-utils \
      ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# Node 18 runtime + npm/npx, copied verbatim from the official node:18 image
# (see the node_source stage above) instead of nodesource's curl-|-bash
# installer. /usr/local is where the node:* images install everything
# (bin/lib/include for node, npm, npx, corepack), so copying that whole
# prefix reproduces the exact same on-PATH layout the rest of this Dockerfile
# (and pnpm below) already assumes.
COPY --from=node_source /usr/local/bin/node /usr/local/bin/node
COPY --from=node_source /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node_source /usr/local/include/node /usr/local/include/node
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version && npm --version && ffmpeg -version | head -1

# pnpm (matches the project's package manager / pnpm-lock.yaml).
RUN npm install -g pnpm@9

# ── Python API deps (identical to Dockerfile.dev) ────────────────────────────
COPY requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

# faster-whisper powers the *Python* local_whisper STT path
# (src/services/transcribe_service.py). It is keyless and downloads a small
# CTranslate2 model on first use into HF_HOME (persisted via volume / baked
# below). Kept out of requirements-dev.txt so the lightweight API image stays
# small; this is the bot-runtime image where STT actually runs.
RUN pip install --no-cache-dir "faster-whisper>=1.0,<2.0"

# ── Node deps (pnpm install against the project lockfile) ────────────────────
# Copy manifests first for layer caching, then install. node_modules includes
# playwright + playwright-extra + @xenova/transformers (local whisper in JS).
COPY package.json pnpm-lock.yaml ./
# Browsers live in a shared, world-readable path so the bot resolves Chromium
# regardless of HOME (LocalBotRunner._chromium_present also probes ~/.cache,
# but PLAYWRIGHT_BROWSERS_PATH is the canonical location).
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Skip puppeteer's chrome-headless-shell download — the bot uses Playwright
# Chromium (installed explicitly below), and the puppeteer download wastes
# ~300MB and was filling the build disk (ENOSPC). Both env names cover old +
# new puppeteer. Also skip Playwright's auto-download during install for the
# same reason (we run `playwright install chromium` deterministically below).
# Skip browser auto-downloads DURING install only (scoped to this RUN, so the
# deterministic explicit chromium install below is unaffected):
#  - puppeteer's chrome-headless-shell is never used by the bot and its ~300MB
#    download was filling the build disk (ENOSPC). Skip it.
#  - playwright's postinstall chromium is redundant — we install the exact
#    playwright-extra-core revision explicitly below. Skip the postinstall one.
RUN PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    sh -c 'pnpm install --frozen-lockfile --prod=false \
      || pnpm install --no-frozen-lockfile --prod=false'

# ── Playwright Chromium + OS deps ────────────────────────────────────────────
# CRITICAL: the bot drives `require('playwright-extra')`, which loads a
# DIFFERENT playwright-core than the top-level `playwright` dep (playwright-extra
# pulls its own playwright-core, often a newer minor that expects a newer
# Chromium build revision). Running the top-level `npx playwright install`
# downloads the WRONG revision and the bot fails at launch with
# "Executable doesn't exist at .../chromium-<rev>/chrome-linux/chrome".
#
# So we install browsers using the EXACT playwright-core that playwright-extra
# resolves — guaranteeing the downloaded chromium revision matches what the bot
# launches at runtime. We additionally run the top-level `install --with-deps`
# once purely to pull the OS apt packages Chromium needs (libnss3, libgbm1,
# fonts, etc.); the binary it fetches is harmless (a few hundred MB) but the one
# the runtime uses is the playwright-extra-core one.
RUN PWX_CORE_CLI="$(node -e "const p=require.resolve('playwright-core/package.json',{paths:[require.resolve('playwright-extra')]}); console.log(require('path').join(require('path').dirname(p),'cli.js'))")" \
 && echo "playwright-extra core CLI: $PWX_CORE_CLI" \
 # OS deps (apt) via top-level playwright — these are shared across revisions.
 && npx playwright install-deps chromium \
 # The actual runtime browser: install chromium with the resolved core so the
 # build revision matches what playwright-extra launches.
 && node "$PWX_CORE_CLI" install chromium \
 && chmod -R a+rX /opt/ms-playwright \
 && echo "Playwright chromium installed at $PLAYWRIGHT_BROWSERS_PATH" \
 && ls /opt/ms-playwright \
 # Pin a STABLE symlink to the chromium the runtime core resolves, so the Python
 # runtime gate (LocalBotRunner._chromium_present, which reads CHROMIUM_PATH)
 # finds a real binary. Resolve it via the runtime core's executablePath().
 && CHROME_BIN="$(node -e "const core=require(require.resolve('playwright-core',{paths:[require.resolve('playwright-extra')]})); console.log(core.chromium.executablePath())")" \
 && echo "runtime chromium executablePath: $CHROME_BIN" \
 && test -x "$CHROME_BIN" \
 && ln -sf "$CHROME_BIN" /usr/local/bin/chromium \
 && echo "linked chromium -> $CHROME_BIN"

# Point both the Python runtime gate and any consumer at the stable symlink.
ENV CHROMIUM_PATH=/usr/local/bin/chromium \
    PLAYWRIGHT_CHROMIUM_PATH=/usr/local/bin/chromium

# ── Local Whisper model cache (keyless STT, no per-run download) ──────────────
# STT cache notes:
#   - Py  (faster-whisper): honors HF_HOME / TRANSFORMERS_CACHE → /opt/hf-cache.
#   - JS  (@xenova/transformers v2): does NOT read those env vars; it caches in
#     its own package dir (node_modules/.../@xenova/transformers/.cache). The
#     pre-bake below loads the model so those files are baked there and the
#     first real transcription is offline (no ~40MB download). HF_HOME/
#     TRANSFORMERS_CACHE are still set for the Python path and for forward
#     compat. If the build host has no network the bake is non-fatal and the
#     model downloads on first run instead. Either way STT is keyless.
ENV HF_HOME=/opt/hf-cache \
    TRANSFORMERS_CACHE=/opt/hf-cache \
    WHISPER_MODEL=tiny.en
RUN mkdir -p /opt/hf-cache \
 && node -e "import('@xenova/transformers').then(async (t)=>{await t.pipeline('automatic-speech-recognition','Xenova/whisper-tiny.en');console.log('baked whisper-tiny.en into '+process.env.HF_HOME);}).catch((e)=>{console.log('whisper pre-bake skipped (will download on first run): '+e.message);})" \
 && chmod -R a+rX /opt/hf-cache || true

# ── Application source ───────────────────────────────────────────────────────
# Mounted as a volume in compose for live reload, but copied so the image is
# runnable standalone.
COPY . /app

# humanclick binary, from the Rust builder stage above. Lands at the exact
# path src/bot/bot_scripts/googlemeet/humanized.js resolves by default
# (../../humanclick/target/release/humanclick relative to that file).
COPY --from=humanclick-builder /build/target/release/humanclick /app/src/bot/humanclick/target/release/humanclick

# ── Entrypoint: start Xvfb + pulseaudio, then exec the API ───────────────────
# Reuses the start-up logic of src/bot/start-bot-runtime.sh (Xvfb :99 + pulse +
# virtual sink) but, instead of idling, EXECs uvicorn so the API and the bots
# it spawns share this container + virtual display.
COPY docker/botruntime-entrypoint.sh /usr/local/bin/botruntime-entrypoint.sh
RUN chmod +x /usr/local/bin/botruntime-entrypoint.sh

# meeting-worker entrypoint: same Xvfb/pulse bring-up, but execs the SIDECAR
# control-plane (src.sidecar.main) instead of the API. The compose worker
# service overrides ENTRYPOINT/CMD to use this so the SAME heavy image serves
# both the in-process standalone API (botruntime-entrypoint) and the separated
# meeting-worker (this script). See docker-compose.worker.yml.
COPY docker/worker-sidecar-entrypoint.sh /usr/local/bin/worker-sidecar-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-sidecar-entrypoint.sh

ENV PYTHONPATH=/app \
    DISPLAY=:99 \
    RUNNING_IN_DOCKER=true \
    HOME=/home/appuser \
    XDG_RUNTIME_DIR=/tmp/runtime-root

# ── Non-root runtime user ────────────────────────────────────────────────────
# Everything above (apt/npm/pip installs, chmod-ing /opt/ms-playwright and
# /opt/hf-cache to a+rX) needs root; the container that actually runs Xvfb,
# pulseaudio, uvicorn, and the Playwright bot does not. `audio`/`video` group
# membership mirrors headful-Chromium container images (e.g. selenium/docker)
# that run Xvfb/pulseaudio as a non-root user — this is a virtual/null audio
# sink and virtual display, not real hardware, but keeping the group
# membership means we don't have to special-case device ACLs if that ever
# changes. /app is chowned recursively because both the FastAPI app and the
# Node bot may write under it (e.g. LocalBotRunner subprocess temp state);
# /opt/ms-playwright and /opt/hf-cache are already world-readable above.
RUN useradd --create-home --uid 10001 --user-group appuser \
 && usermod -aG audio,video appuser \
 && mkdir -p /tmp/runtime-root /tmp/pulse-runtime \
 && chown -R appuser:appuser /app /tmp/runtime-root /tmp/pulse-runtime

USER appuser

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/botruntime-entrypoint.sh"]
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
