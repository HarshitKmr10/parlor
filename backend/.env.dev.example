# Dev runtime env for docker-compose.dev.yml.
#
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up --build
#
# All values below have safe local defaults baked into the compose file; this
# file lets you override them. NEVER commit real secrets — JWT_SECRET here is a
# throwaway dev value and MUST be replaced in any shared/staging/prod env.

# ─── Postgres (pgvector) ───────────────────────────────────────────────────
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting
POSTGRES_DB=meeting
# Host port the DB is published on (container always listens on 5432).
POSTGRES_PORT=5433

# ─── Backend API ───────────────────────────────────────────────────────────
# Host port the API is published on.
API_PORT=8000
LOG_LEVEL=INFO

# Product auth — generate a strong value for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me

# Internal ai-service base URL (summarize/chat). Unreachable in dev is fine;
# /summarize and /ask return a 503 error envelope rather than crashing.
AI_SERVICE_URL=http://localhost:8100

# CORS origin for the Next.js dashboard.
ALLOWED_ORIGINS=http://localhost:3000
