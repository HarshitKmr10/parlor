# meeting-joiner specific gitignore (additive to the repo root .gitignore).
#
# Allow the bundled env template so vendor consumers can read the
# documented contract; the repo root .gitignore's `.env*` rule would
# otherwise exclude it.

!.env.example
!.env.dev.example
!envs/*.example.env

# Local env files (per-developer) stay ignored.
.env
.env.dev
envs/*.env

# Local dev virtualenv created for the standalone product API runtime.
.venv-dev/

# Google Meet signed-in bot auth artifacts (LIVE session cookies — never commit).
# Playwright storageState JSON holds cookies + localStorage for the notetaker
# account; treat it like a password.
auth.json
*.auth.json
**/auth.json
**/*.auth.json
secrets/auth/
**/google-auth-state/
src/bot/bot_scripts/googlemeet/auth.json
