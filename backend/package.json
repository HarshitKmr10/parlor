{
  "name": "meeting-joiner-service",
  "version": "1.0.0",
  "description": "Meeting Joiner Bot Service (MS Teams, Zoom, Google Meet)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:bootstrap": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/bootstrap.sql",
    "db:install-schema": "python3 src/scripts/install_schema.py",
    "db:drift": "node db/extract-bootstrap.mjs",
    "db:generate:monorepo": "prisma generate --schema=../core/core/db/prisma/schema.prisma",
    "db:migrate:monorepo": "prisma migrate dev --schema=../core/core/db/prisma/schema.prisma",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.896.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/client-sts": "^3.894.0",
    "@aws-sdk/client-transcribe": "^3.894.0",
    "@aws-sdk/client-transcribe-streaming": "^3.896.0",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.26.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-metrics": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@smithy/node-http-handler": "^4.0.6",
    "@xenova/transformers": "^2.17.2",
    "aws-sdk": "^2.1579.0",
    "axios": "^1.16.0",
    "body-parser": "^1.20.4",
    "chrome-remote-interface": "^0.33.2",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.5.0",
    "express": "^4.22.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.1.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "openai": "^4.81.0",
    "pg": "^8.11.0",
    "pino": "^9.5.0",
    "playwright": "1.56.0",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^24.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-stream": "^3.0.19",
    "uuid": "^11.1.1",
    "winston": "^3.17.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": "^5.3.1",
      "form-data": "^4.0.4",
      "fast-xml-parser": "^5.3.6",
      "jws": "^3.2.3",
      "minimatch@3": "^3.1.3",
      "brace-expansion@1": "^1.1.13",
      "brace-expansion@2": "^2.0.3"
    }
  },
  "keywords": [
    "msteams",
    "zoom",
    "googlemeet",
    "bot",
    "meeting",
    "transcription",
    "microservice"
  ],
  "author": "AIOps Team",
  "license": "MIT"
}
