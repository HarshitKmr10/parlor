# Meeting Joiner Service Environment Configuration

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/aiops_db"
DIRECT_URL="postgresql://username:password@localhost:5432/aiops_db"
MEETING_JOINER_DB_DRIVER=pg
MEETING_JOINER_SCHEMA=public
MEETING_JOINER_PGQUEUER_SCHEMA=pgqueuer

# Storage Configuration
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net"
STORAGE_BUCKET_NAME="meeting-recordings"

# Zoom SDK Configuration
ZOOM_APP_KEY="your_zoom_app_key_here"
ZOOM_APP_SECRET="your_zoom_app_secret_here"
ZOOM_WEB_DOMAIN="zoom.us"
ZOOM_SDK_PATH="/opt/zoom-sdk"

# Recording Configuration
RECORDING_OUTPUT_DIR="/app/meeting-joiner/recordings"
ENABLE_LOCAL_RECORDING=true
ENABLE_CLOUD_RECORDING=false
RECORDING_QUALITY=HD

# Chrome/Puppeteer Configuration (fallback browser mode)
CHROME_BIN="/usr/bin/google-chrome"
PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
FORCE_HEADLESS=false

# Google Meet Configuration
GOOGLE_MEET_ENABLED=true
GOOGLE_MEET_ADMISSION_TIMEOUT_MS=120000
GOOGLE_MEET_ALONE_TIMEOUT_SECONDS=600
GOOGLE_MEET_EVERYONE_LEFT_TIMEOUT_SECONDS=10
# Hard wall-clock cap on a single Meet — bot leaves with reason
# 'max_meeting_time' if exceeded. Default 8 h covers all-day workshops.
GOOGLEMEET_MAX_MEETING_MS=28800000

# Microsoft Teams Configuration
# csrc_asr: transcribe captured audio through the configured ASR provider.
# teams_captions: use Teams platform captions and skip ASR audio capture.
MSTEAMS_TRANSCRIPT_SOURCE=csrc_asr
MSTEAMS_CAPTIONS_LANGUAGE=
# Hard wall-clock cap on a single Teams meeting — bot leaves with
# reason 'max_meeting_time' if exceeded. Default 8 h.
MSTEAMS_MAX_MEETING_MS=28800000

# Runtime Configuration
NODE_ENV=production
LOG_LEVEL=info
RUNNING_IN_DOCKER=true
DISPLAY=:99

# Service Configuration
PORT=3001
HOST=0.0.0.0
