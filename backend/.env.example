# meeting-joiner — environment template
#
# Copy to .env (or set via your secret manager) and fill in the placeholders.
# Real secrets must never be committed; this file only ships placeholders.
#
# Precedence at runtime (highest wins):
#   1. process.env (K8s ConfigMap/Secret, docker-compose `environment:`)
#   2. meeting-joiner/.env (standalone local dev)
#   3. meeting-joiner/envs/${NODE_ENV}.env (optional, per-env override file)
#
# Keys marked <REQUIRED> must be set. Keys marked <OPTIONAL> have safe defaults.
# Keys marked <PLATFORM-X> only matter for that platform; ignore them for others.

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=<REQUIRED>                       # pooled Postgres DSN (pgbouncer ok)
DIRECT_URL=<OPTIONAL>                         # non-pooled DSN; used by long-running queue workers when present

# Driver selection — see meeting-joiner/db/README.md for the trade-offs.
# `pg`     standalone deployments; raw SQL via node-postgres / asyncpg, no Prisma needed
# `prisma` monorepo deployments; uses ../core/core/db/prisma/schema.prisma
MEETING_JOINER_DB_DRIVER=pg
MEETING_JOINER_PG_MAX=10                      # pg.Pool / asyncpg.Pool max size
MEETING_JOINER_SCHEMA=public                  # set to meeting_joiner when sharing a DB with another app
MEETING_JOINER_PGQUEUER_SCHEMA=pgqueuer       # set to meeting_joiner_pgqueuer when sharing a DB
MEETING_JOINER_BOOTSTRAP_ON_START=false       # if true, the standalone image applies db/bootstrap.sql at boot

# ─── Service basics ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info

# ─── Bot identity / limits ────────────────────────────────────────────────
BOT_NAME=AI Notetaker
MAX_MEETING_DURATION_HOURS=8
MAX_MEETING_DURATION_MINUTES=480
AUTO_LEAVE_TIMEOUT_MINUTES=3
TRANSCRIPT_UPDATE_INTERVAL_MS=5000
MIN_SEGMENT_TEXT_LENGTH=0

# ─── Recording / storage (Azure Blob) ─────────────────────────────────────
AZURE_STORAGE_AUTH=auto                       # auto | connection_string | managed_identity
AZURE_STORAGE_CONNECTION_STRING=<OPTIONAL>    # connection-string path
AZURE_STORAGE_ACCOUNT_NAME=<OPTIONAL>         # managed identity path
AZURE_STORAGE_BLOB_ENDPOINT=<OPTIONAL>        # managed identity/private DNS override
AZURE_STORAGE_CONTAINER_NAME=meeting-recordings
RECORDING_UPLOAD_DISABLED=false

# ─── LLM / transcription provider selection ───────────────────────────────
# Pick ONE primary provider for ASR. Others are used only as overrides per-meeting.
LLM_PROVIDER=aws_transcribe                   # aws_transcribe | azure_speech | azure_openai | openai | local_whisper

# Local Whisper (KEYLESS, OFFLINE) — set LLM_PROVIDER=local_whisper to run
# whisper in-process via @xenova/transformers (Node) / faster-whisper (Python).
# No cloud account, no API key, works on any Linux/Mac. The model downloads
# once on first use (~40MB for tiny) and then runs fully offline.
WHISPER_MODEL=tiny.en                         # tiny.en (default) | tiny | base
# Keyless fallback: if the cloud provider above has no detectable
# credentials, automatically fall back to local_whisper (with a warning) so
# a dev box still transcribes. Set false in prod to fail fast instead.
STT_FALLBACK_LOCAL=true                       # true (default) | false
# Model cache dir for local whisper (pre-bake/persist in Docker to skip the
# first-run download). Either var works; Transformers.js reads both.
# TRANSFORMERS_CACHE=/var/cache/whisper
# HF_HOME=/var/cache/whisper

# OpenAI (general LLM tasks)
OPENAI_API_KEY=<OPTIONAL>

# Azure OpenAI (used when LLM_PROVIDER=azure or for end-of-meeting cleanup)
AZURE_OPENAI_API_KEY=<OPTIONAL>
AZURE_OPENAI_ENDPOINT=<OPTIONAL>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# AWS (Transcribe + S3 + Bedrock)
AWS_ACCESS_KEY_ID=<OPTIONAL>
AWS_SECRET_ACCESS_KEY=<OPTIONAL>
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<OPTIONAL>
S3_BUCKET_NAME=<OPTIONAL>
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Azure Speech (per-track ASR streaming)
AZURE_SPEECH_AUTH=auto                        # auto | key | managed_identity
AZURE_SPEECH_ENDPOINT=<OPTIONAL>              # required for managed_identity; use the Speech resource custom subdomain
AZURE_SPEECH_KEY=<OPTIONAL>
AZURE_SPEECH_REGION=<OPTIONAL>
AZURE_SPEECH_CONTAINER_ENDPOINT=<OPTIONAL>
AZURE_SPEECH_DEBUG=false
AZURE_SPEECH_DISABLE_CRL_CHECK=false
AZURE_SPEECH_SEGMENTATION_SILENCE_TIMEOUT_MS=1500

# Transcription routing
TRANSCRIPTION_LANGUAGE=en-US
TRANSCRIBE_STREAMING=true
TRANSCRIPTION_FALLBACK_MODE=false
FORCE_TRANSCRIPTION_FALLBACK=false
ASR_PROVIDER=aws

# AWS Transcribe Medical (optional medical-domain mode)
TRANSCRIBE_MEDICAL_STREAMING=false
TRANSCRIBE_MEDICAL_SPECIALTY=PRIMARYCARE
TRANSCRIBE_MEDICAL_VOCABULARY_NAME=<OPTIONAL>

# HealthScribe (optional)
HEALTHSCRIBE_OUTPUT_BUCKET=<OPTIONAL>
HEALTHSCRIBE_DATA_ACCESS_ROLE_ARN=<OPTIONAL>
HEALTHSCRIBE_KMS_KEY_ID=<OPTIONAL>
HEALTHSCRIBE_ROLE_NAME=<OPTIONAL>
HEALTHSCRIBE_SPECIALTY=<OPTIONAL>
HEALTHSCRIBE_VOCABULARY_NAME=<OPTIONAL>
HEALTHSCRIBE_VOCABULARY_FILTER_NAME=<OPTIONAL>

# ─── End-of-meeting LLM cleanup pass ──────────────────────────────────────
TRANSCRIPT_CLEANUP_ENABLED=false
TRANSCRIPT_CLEANUP_PROVIDER=bedrock
TRANSCRIPT_CLEANUP_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
TRANSCRIPT_CLEANUP_AGGRESSIVE=false
TRANSCRIPT_CLEANUP_SEGMENTS_PER_CHUNK=50
TRANSCRIPT_CLEANUP_OVERLAP=5
TRANSCRIPT_CLEANUP_MAX_CHARS=16000

# ─── Audio archive (debug, default OFF) ───────────────────────────────────
AUDIO_ARCHIVE_ENABLED=false
AUDIO_ARCHIVE_CHUNK_SECONDS=300
AUDIO_ARCHIVE_OPUS=false
AUDIO_ARCHIVE_QUEUE_DEPTH=10

# ─── Zoom (<PLATFORM-ZOOM>) ───────────────────────────────────────────────
ZOOM_APP_CLIENT_ID=<OPTIONAL>
ZOOM_APP_CLIENT_SECRET=<OPTIONAL>

# ─── Google Meet (<PLATFORM-MEET>) ────────────────────────────────────────
GOOGLE_ACCOUNT_USER=<OPTIONAL>                # only if you need authenticated meets
GOOGLE_ACCOUNT_PASSWORD=<OPTIONAL>
GOOGLE_MEET_USE_AUTH=false
GOOGLE_MEET_ADMISSION_TIMEOUT_MS=120000
GOOGLEMEET_CAPTURE_MODE=audio_asr             # audio_asr | gmeet_captions
GOOGLEMEET_TRANSCRIPT_SOURCE=audio_asr
GOOGLEMEET_MAX_MEETING_MS=14400000

# ─── MS Teams (<PLATFORM-TEAMS>) ──────────────────────────────────────────
MSTEAMS_TRANSCRIPT_SOURCE=teams_captions      # teams_captions | audio_asr
MSTEAMS_ENABLE_CAPTIONS=true
MSTEAMS_CAPTIONS_LANGUAGE=
MSTEAMS_ATTRIBUTION_MODE=webrtc_csrc          # webrtc_csrc | dom
MSTEAMS_CSRC_ROUTING=floor_owner              # floor_owner | earliest_start
MSTEAMS_CSRC_MAX_SESSIONS=5
MSTEAMS_CSRC_LOCK_THRESHOLD=3
MSTEAMS_ASR_PROVIDER=azure                    # azure | aws

# Aloneness / track-presence tuning (drop detection)
MSTEAMS_STARTUP_ALONE_MS=1200000
MSTEAMS_ALONE_GRACE_MS=300000
MSTEAMS_POSTSPEAKER_ALONE_MS=60000
MSTEAMS_TRACK_PRESENCE_ENABLED=true
MSTEAMS_TRACK_PRESENCE_POLL_MS=2000
MSTEAMS_TRACK_PRESENCE_EMPTY_GRACE_MS=30000
MSTEAMS_TRACK_PRESENCE_SEEN_FIRST_MS=120000

# Browser / join flow
MSTEAMS_HEADLESS=false
MSTEAMS_USE_STEALTH=true
MSTEAMS_CHROME_CHANNEL=
MSTEAMS_TZ=America/Los_Angeles
MSTEAMS_LOBBY_MS=60000
MSTEAMS_JOIN_BUDGET_MS=15000
MSTEAMS_PREJOIN_MS=45000
MSTEAMS_MAX_MEETING_MS=28800000
MSTEAMS_CHUNK_MS=5000
MSTEAMS_MEETING_DIR=/tmp/msteams_meetings
MSTEAMS_DUMP_AUDIO=false
MSTEAMS_RMS_FLOOR=0.005

# CSRC audio dump (debug)
MSTEAMS_CSRC_AUDIO_DUMP_ENABLED=false
MSTEAMS_CSRC_AUDIO_DUMP_DIR=/tmp/meeting-csrc-audio
MSTEAMS_CSRC_AUDIO_DUMP_MAX_SECONDS=900
MSTEAMS_CSRC_AUDIO_DUMP_RUN_ID=

# Floor-owner tuning
MSTEAMS_FLOOR_PRE_ROLL_MS=600
MSTEAMS_FLOOR_RESOLVE_LAG_MS=400
MSTEAMS_FLOOR_QUEUE_LAG_MS=1500
MSTEAMS_FLOOR_MIN_SOLO_MS=200
MSTEAMS_FLOOR_NOISE_NAME_PATTERN=

# Accuracy + dedupe
MSTEAMS_ACCURACY_REPORT_ENABLED=false
MSTEAMS_TRANSCRIPT_DEDUPE_ENABLED=false

# ─── Browser runtime (set automatically inside the standalone Dockerfile) ─
CHROME_BIN=
PUPPETEER_EXECUTABLE_PATH=
DISPLAY=
RUNNING_IN_DOCKER=
PULSE_SINK=

# Container-only heartbeat
STREAMING_HEARTBEAT_MS=30000

# ─── Org-wide Google Workspace capture (Round 3) ──────────────────────────
# Master gate for the domain-wide calendar sync loop. Default false: the app
# boots with NO Google creds and the sync no-ops. When true, the loop runs only
# for workspaces that POST an *enabled* org config to /api/v1/google-workspace.
# Per-org auth (service-account JSON, delegated admin email) is uploaded via
# that endpoint and stored Fernet-encrypted in the DB — never in env.
GOOGLE_WORKSPACE_ENABLED=false

# The org-wide flow reuses the calendar token encryption key and poll cadence:
#   CALENDAR_TOKEN_KEY        — Fernet key; also encrypts the service-account JSON
#   CALENDAR_POLL_INTERVAL_S  — sync tick interval (default 60)
#   CALENDAR_JOIN_LEAD_MINUTES — join meetings starting within N minutes (default 5)
CALENDAR_TOKEN_KEY=<OPTIONAL>
CALENDAR_POLL_INTERVAL_S=60
CALENDAR_JOIN_LEAD_MINUTES=5

# ─── Ad-hoc / instant Meet capture via Workspace Events + Pub/Sub (Pass 2) ──
# Catches meetings that NEVER touch a calendar (someone starts an instant Meet)
# by subscribing to Meet conference lifecycle events fanned out across org users
# and dispatching the bot from a Cloud Pub/Sub push to our webhook.
#
# To go live (Google/GCP side):
#   1. Create a Pub/Sub TOPIC; grant the Workspace Events service agent
#      (meet-api-event-push@system.gserviceaccount.com) the Publisher role on it.
#   2. Create a PUSH subscription on that topic whose endpoint is this service's
#      webhook: https://<your-host>/api/v1/google/pubsub/push  — secured with
#      EITHER an OIDC token (set audience = the push URL) OR a ?token=<secret>.
#   3. Grant the DWD service account the Meet scope
#      (https://www.googleapis.com/auth/meetings.space.readonly) in the Admin
#      console alongside the directory + calendar scopes.
#   4. POST /api/v1/google-workspace then POST /api/v1/google-workspace/events/
#      subscribe to provision per-user subscriptions.
#
# The Cloud Pub/Sub topic the subscriptions publish to (projects/<p>/topics/<t>).
# Unset => subscribe routes 400 (pubsub_not_configured); webhook 202 ack-ignore.
GOOGLE_PUBSUB_TOPIC=<OPTIONAL>
# Shared-secret query token guarding the webhook (push URL appends ?token=...).
# Use this OR the OIDC audience below; OIDC is preferred in production.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=<OPTIONAL>
# Expected audience of the Pub/Sub push OIDC bearer token (= the push endpoint
# URL). When set, the webhook verifies a Google-signed OIDC token.
GOOGLE_PUBSUB_OIDC_AUDIENCE=<OPTIONAL>
# Optional: pin the push subscription's OIDC service-account email.
GOOGLE_PUBSUB_OIDC_SERVICE_ACCOUNT=<OPTIONAL>
# Default Workspace account the notetaker bot joins meetings AS (auto-admission
# to internal meetings). Per-workspace override stored in the DB; this is the
# process-wide fallback.
MEET_NOTETAKER_EMAIL=<OPTIONAL>
# Renew Workspace Events subscriptions this many minutes before they expire.
MEET_EVENTS_RENEW_LEAD_MINUTES=60
MEET_EVENTS_RENEW_INTERVAL_S=300
