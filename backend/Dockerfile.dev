# Lightweight dev image for the standalone backend + /api/v1 product layer.
#
# Unlike infra/docker/meeting_worker.Dockerfile (which bundles Chromium, the
# Zoom SDK, PulseAudio, etc. to actually drive meetings), this image only runs
# the FastAPI app: auth, workspaces, and product meeting endpoints against a
# plain Postgres. The bot-join path is exercised in the full image.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# build deps for asyncpg / argon2 wheels (most ship wheels, but be safe)
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libpq-dev postgresql-client curl \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

# Source is mounted as a volume in docker-compose.dev.yml for live reload, but
# copy it too so the image is runnable on its own.
COPY . /app

ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
