# =============================================================================
# Parlor meeting-assistant — full-stack dev environment
# =============================================================================
# Copy to `.env` (never commit `.env`) and adjust as needed:
#
#   cp .env.example .env
#   make up
#
# The stack comes up fully WITHOUT any LLM keys: ai-service runs in mock mode
# (AI_MODE=mock) so summarize/embed/chat return deterministic structured data.
# Add real provider keys (see bottom) to switch from mock -> live.
#
# NEVER put real secrets in `.env.example`. The values here are safe local
# placeholders / dev defaults only.
# =============================================================================

# ─── Postgres (shared pgvector DB used by BOTH backend and ai-service) ───────
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting
POSTGRES_DB=meeting
# Host port the DB is published on (container always listens on 5432 internally).
# 5432 is often taken by a local Postgres — default to 5434 to avoid clashes.
POSTGRES_PORT=5434

# ─── Host ports (browser / dev access) ──────────────────────────────────────
# Inter-service traffic uses Docker DNS (service names) and is unaffected by
# these. These only control what the host machine exposes. Defaults avoid the
# commonly-occupied 8000 / 3000 / 8100.
# backend FastAPI  -> http://localhost:8001
API_PORT=8001
# ai-service       -> http://localhost:8101 (rarely needed directly)
AI_PORT=8101
# Next.js web app  -> http://localhost:3001
WEB_PORT=3001
# meeting-worker sidecar -> http://localhost:9000 (the SEPARATE bot container).
MEETING_WORKER_PORT=9000

# ─── Separated meeting-worker (the bot runs in its OWN container) ────────────
# `make up` brings up the bot as a distinct `meeting-worker` container and the
# backend API runs RUNTIME_MODE=compose, dispatching meetings to the worker's
# sidecar over HTTP (POST /configure). This mirrors prod (API pod ↔ bot pod).
#
# Worker sidecar base URL(s) as seen from the backend over Docker DNS.
# Comma-separate for a small local pool (one concurrent meeting per worker);
# a single worker = one concurrent meeting locally. Concurrency at scale is the
# K8s warm pool via Helm, not this list.
MEETING_WORKER_SIDECAR_URL=http://meeting-worker:9000
# Backend API base URL the worker calls for /internal/sessions/ended on bot exit.
MEETING_JOINER_API_URL=http://backend:8000
# Shared secret authenticating the worker's session-ended callback to the API.
# Leave blank in dev (callback is accepted-all when unset). Generate for prod:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SIDECAR_CALLBACK_TOKEN=
# Bot display name shown in the meeting.
BOT_NAME=Parlor Notetaker

# ─── Backend product API ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Product-auth JWT signing secret. Generate a strong value for anything beyond
# local dev:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
# CORS origin for the browser. Must match how you reach the web app.
ALLOWED_ORIGINS=http://localhost:3001

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
# Backend base URL as seen by the BROWSER. Must be the host-published API_PORT.
# (Server-side rendering inside the web container also uses this; see README
# "Known limitations" for the internal-DNS caveat.)
NEXT_PUBLIC_API_URL=http://localhost:8001

# ─── AI service ──────────────────────────────────────────────────────────────
# mock | live | (blank = auto-detect: live only when a key is present).
# Keep `mock` for a key-free reproducible stack; set `live` to use Azure/etc.
AI_MODE=mock
# Provider routing order (first success wins, falls through on error).
AI_PROVIDER_ORDER=azure,anthropic,openai

# ─── Azure OpenAI (primary LIVE provider) ───────────────────────────────────
# Azure routes by DEPLOYMENT NAME, not model id. Set the endpoint + key to go
# live; the chat deployment is the resource's "mini" deployment. NEVER commit
# real keys — fill these in your gitignored .env only.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Optional. If unset, embeddings fall through to the deterministic mock embedder.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional, informational only.
AZURE_REGION=eastus2

# ─── Optional LLM provider keys (additional fallbacks) ──────────────────────
# Leave BLANK for mock mode. Azure above is the primary live provider; these
# remain as fall-through if Azure is unset or a call fails.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Optional integrations (not required for the stack to boot) ─────────────
# Calendar OAuth (Google / Microsoft). Filling these in enables the
# /api/v1/calendar/connect/* OAuth flows; the stack runs fine without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/calendar/callback/google
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8001/api/v1/calendar/callback/microsoft

# Slack notifications (optional).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Outbound email / SMTP (optional — meeting summaries, invites).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@parlor.local

# Google/Microsoft calendar per-user OAuth (placeholders — set real values in .env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_BASE=http://localhost:8001

# Org-wide Google Workspace / Meet capture (placeholders)
GOOGLE_WORKSPACE_ENABLED=true
# Fernet key encrypting the org's service-account JSON at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_KEY=
MEET_NOTETAKER_EMAIL=
GOOGLE_PUBSUB_TOPIC=
# Shared-secret query token guarding the Pub/Sub push webhook. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PUBSUB_OIDC_AUDIENCE=
