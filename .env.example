# =============================================================================
# Verdant meeting-assistant — full-stack dev environment
# =============================================================================
# Copy to `.env` (never commit `.env`) and adjust as needed:
#
#   cp .env.example .env
#   make up
#
# The stack comes up fully WITHOUT any LLM keys: ai-service runs in mock mode
# (AI_MODE=mock) so summarize/embed/chat return deterministic structured data.
# Add real provider keys (see bottom) to switch from mock -> live.
#
# NEVER put real secrets in `.env.example`. The values here are safe local
# placeholders / dev defaults only.
# =============================================================================

# ─── Postgres (shared pgvector DB used by BOTH backend and ai-service) ───────
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting
POSTGRES_DB=meeting
# Host port the DB is published on (container always listens on 5432 internally).
# 5432 is often taken by a local Postgres — default to 5434 to avoid clashes.
POSTGRES_PORT=5434

# ─── Host ports (browser / dev access) ──────────────────────────────────────
# Inter-service traffic uses Docker DNS (service names) and is unaffected by
# these. These only control what the host machine exposes. Defaults avoid the
# commonly-occupied 8000 / 3000 / 8100.
# backend FastAPI  -> http://localhost:8001
API_PORT=8001
# ai-service       -> http://localhost:8101 (rarely needed directly)
AI_PORT=8101
# Next.js web app  -> http://localhost:3001
WEB_PORT=3001

# ─── Backend product API ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Product-auth JWT signing secret. Generate a strong value for anything beyond
# local dev:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
# CORS origin for the browser. Must match how you reach the web app.
ALLOWED_ORIGINS=http://localhost:3001

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
# Backend base URL as seen by the BROWSER. Must be the host-published API_PORT.
# (Server-side rendering inside the web container also uses this; see README
# "Known limitations" for the internal-DNS caveat.)
NEXT_PUBLIC_API_URL=http://localhost:8001

# ─── AI service ──────────────────────────────────────────────────────────────
# mock | live | (blank = auto-detect: live only when a key is present).
# Keep `mock` so the stack is reproducible with no external dependencies.
AI_MODE=mock
# Provider routing order (first success wins, falls through on error).
AI_PROVIDER_ORDER=anthropic,openai

# ─── Optional LLM provider keys (mock -> live) ──────────────────────────────
# Leave BLANK for mock mode. Set AI_MODE=live (or blank to auto-detect) and add
# at least one key to switch the AI to real model calls. No other change needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Optional integrations (not required for the stack to boot) ─────────────
# Calendar OAuth (Google / Microsoft). Filling these in enables the
# /api/v1/calendar/connect/* OAuth flows; the stack runs fine without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/calendar/callback/google
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8001/api/v1/calendar/callback/microsoft

# Slack notifications (optional).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Outbound email / SMTP (optional — meeting summaries, invites).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@verdant.local
