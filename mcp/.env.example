# Parlor MCP server configuration.
# Copy to `.env` and fill in, or set these in your MCP client config.

# Backend product API base URL (no trailing slash). Default: http://localhost:8000
PARLOR_API_URL=http://localhost:8000

# Workspace API key — REQUIRED. Sent as the X-API-Key header.
# Create one in the Parlor app: Settings -> API Keys (the key is shown once).
PARLOR_API_KEY=vk_live_replace_me

# Optional workspace id — sent as the X-Workspace-Id header to select the
# active workspace. Often unnecessary when the API key is workspace-scoped.
PARLOR_WORKSPACE_ID=
